{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "const": "ok"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": 1
            },
            "coverage": {
              "enum": [
                "provided_sbom_components",
                "supported_registry_dependencies",
                "supported_text_files",
                "configured_scanners"
              ]
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "enum": [
                "complete",
                "incomplete"
              ]
            },
            "complete": {
              "type": "boolean"
            },
            "packages_discovered": {
              "type": "integer",
              "minimum": 0
            },
            "packages_checked": {
              "type": "integer",
              "minimum": 0
            },
            "files_checked": {
              "type": "integer",
              "minimum": 0
            },
            "findings": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "schema_version": {
                        "const": 1
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "rule_id": {
                        "type": "string"
                      },
                      "severity": {
                        "enum": [
                          "unknown",
                          "low",
                          "medium",
                          "high",
                          "critical"
                        ]
                      },
                      "title": {
                        "type": "string"
                      },
                      "files": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "remediation": {
                        "type": "string"
                      },
                      "reachability": {
                        "const": "not_analyzed"
                      },
                      "category": {
                        "enum": [
                          "dependency_vulnerability",
                          "dependency_maintenance",
                          "dependency_advisory"
                        ]
                      },
                      "package": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          },
                          "ecosystem": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "version",
                          "ecosystem"
                        ],
                        "additionalProperties": false
                      },
                      "evidence": {
                        "type": "object",
                        "properties": {
                          "source": {
                            "const": "OSV"
                          },
                          "advisory_id": {
                            "type": "string"
                          },
                          "advisory_kind": {
                            "enum": [
                              "vulnerability",
                              "maintenance",
                              "unknown"
                            ]
                          }
                        },
                        "required": [
                          "source",
                          "advisory_id",
                          "advisory_kind"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "schema_version",
                      "id",
                      "rule_id",
                      "severity",
                      "title",
                      "files",
                      "remediation",
                      "reachability",
                      "category",
                      "package",
                      "evidence"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "schema_version": {
                        "const": 1
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "rule_id": {
                        "type": "string"
                      },
                      "severity": {
                        "enum": [
                          "unknown",
                          "low",
                          "medium",
                          "high",
                          "critical"
                        ]
                      },
                      "title": {
                        "type": "string"
                      },
                      "files": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "remediation": {
                        "type": "string"
                      },
                      "reachability": {
                        "const": "not_analyzed"
                      },
                      "category": {
                        "const": "secret"
                      },
                      "location": {
                        "type": "object",
                        "properties": {
                          "file": {
                            "type": "string"
                          },
                          "line": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "column": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "file",
                          "line",
                          "column"
                        ],
                        "additionalProperties": false
                      },
                      "evidence": {
                        "type": "object",
                        "properties": {
                          "source": {
                            "const": "Sentinel"
                          },
                          "redacted": {
                            "const": "[REDACTED]"
                          }
                        },
                        "required": [
                          "source",
                          "redacted"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "schema_version",
                      "id",
                      "rule_id",
                      "severity",
                      "title",
                      "files",
                      "remediation",
                      "reachability",
                      "category",
                      "location",
                      "evidence"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "maxItems": 100000
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "package": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          },
                          "ecosystem": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "version",
                          "ecosystem"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "file": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "package",
                  "file",
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "cache": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "package": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "version": {
                        "type": "string"
                      },
                      "ecosystem": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "version",
                      "ecosystem"
                    ],
                    "additionalProperties": false
                  },
                  "age_seconds": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "stale": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "package",
                  "age_seconds",
                  "stale"
                ],
                "additionalProperties": false
              }
            },
            "audit_logging": {
              "enum": [
                "recorded",
                "disabled",
                "failed"
              ]
            }
          },
          "required": [
            "schema_version",
            "coverage",
            "inputs",
            "status",
            "complete",
            "packages_discovered",
            "packages_checked",
            "files_checked",
            "findings",
            "diagnostics",
            "cache",
            "audit_logging"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "complete": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "complete"
                  }
                }
              },
              "else": {
                "properties": {
                  "status": {
                    "const": "incomplete"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "status",
        "message",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
