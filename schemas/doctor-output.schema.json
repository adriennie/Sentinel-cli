{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "const": "ok"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": 1
            },
            "binary_version": {
              "type": "string"
            },
            "policy_schema_version": {
              "const": 1
            },
            "status": {
              "enum": [
                "pass",
                "warn",
                "fail"
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "binary.version",
                      "project.discovery",
                      "policy.configuration",
                      "audit.storage",
                      "audit.history",
                      "scanner.dependencies",
                      "cache.storage",
                      "cache.intelligence",
                      "scanner.secrets",
                      "integrations"
                    ]
                  },
                  "status": {
                    "enum": [
                      "pass",
                      "warn",
                      "fail"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "remediation": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "status",
                  "message",
                  "remediation"
                ],
                "additionalProperties": false
              },
              "minItems": 2
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "dependency_scanning": {
                  "type": "boolean"
                },
                "secrets_scanning": {
                  "type": "boolean"
                },
                "audit_logging": {
                  "type": "boolean"
                },
                "agent_enforcement": {
                  "type": "boolean"
                }
              },
              "required": [
                "dependency_scanning",
                "secrets_scanning",
                "audit_logging",
                "agent_enforcement"
              ],
              "additionalProperties": false
            },
            "dependency_cache": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "packages_total": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "packages_inspected": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "available": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "stale": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "missing_or_invalid": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "packages_total",
                    "packages_inspected",
                    "available",
                    "stale",
                    "missing_or_invalid"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "exit_code": {
              "enum": [
                0,
                1,
                3
              ]
            },
            "audit_logging": {
              "enum": [
                "recorded",
                "disabled",
                "failed"
              ]
            }
          },
          "required": [
            "schema_version",
            "binary_version",
            "policy_schema_version",
            "status",
            "checks",
            "capabilities",
            "dependency_cache",
            "exit_code"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "fail"
                  }
                }
              },
              "then": {
                "properties": {
                  "exit_code": {
                    "enum": [
                      1,
                      3
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "exit_code": {
                    "const": 0
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "status",
        "message",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
